# Copy to .env and fill in. NEVER commit .env — only this file.
# In production these are set in the hosting dashboard, not in a file.

# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=https://esi.your-institution.edu      # base URL used to build assessment links
CORS_ORIGIN=                                  # blank = reflect request origin; set explicitly in production

# ─── Storage ──────────────────────────────────────────────────────────────────
# postgres (default when DATABASE_URL is set) or memory (dev/tests only)
ESI_STORE=postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PG_POOL_MAX=10

# ─── Admin ────────────────────────────────────────────────────────────────────
# Bearer token for every /api/admin/esi/* route. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=generate-a-long-random-string
